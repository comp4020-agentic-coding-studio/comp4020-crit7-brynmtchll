---
import Base from "../layouts/Base.astro";
import { LIMITED, clientOf, guardedLookup } from "../lib/limits";
import { NAME_LENGTH, currentPerson, normaliseShareCode, personByShareCode } from "../lib/people";

const add = normaliseShareCode(Astro.url.searchParams.get("add") ?? "");

// Signed in, the app's home is your week; arriving by a friend's link, it's
// the offer to add them.
const me = currentPerson(Astro.cookies);
if (me) return Astro.redirect(add ? `/friends/?add=${add}` : "/overlay/");

// From a friend's share link, carried through making a timetable. Guarded:
// a GET that names a code's owner is as good as adding them.
const found = add
  ? guardedLookup(clientOf(Astro.request, Astro.clientAddress), () => personByShareCode(add))
  : undefined;
const inviter = found === LIMITED ? undefined : found;
const deleted = Astro.url.searchParams.has("deleted");
---

<Base title="Home" width="wide">
  {
    deleted && (
      <p class="notice success" role="status">
        Your timetable is deleted, from every device.
      </p>
    )
  }
  <section class="hero">
    <h1>{inviter ? `${inviter.name} wants to share timetables with you` : "Your ANU timetable, next to your friends'"}</h1>
    <p class="lead">
      {
        inviter
          ? `Make yours in a minute, and ${inviter.name}'s week goes next to it: the classes you share, when you're both free, and where they are right now.`
          : "See who's in your tutes, when you're all free, and who's in class right now. It works from the file MyTimetable already gives you."
      }
    </p>
    <form method="post" action="/api/people" class="card start">
      <div class="field">
        <label for="name">Your name</label>
        <span class="hint" id="name-hint">As friends know you. There's no password.</span>
        <div class="inline-field">
          <input
            id="name"
            name="name"
            required
            maxlength={NAME_LENGTH}
            autocomplete="nickname"
            aria-describedby="name-hint"
          />
          <button class="primary">Make my timetable</button>
        </div>
      </div>
      {inviter && <input type="hidden" name="add" value={add} />}
      <p class="fine">
        Already have one on another device? <a href="/link/">Link this device</a>.
      </p>
    </form>
  </section>

  <section aria-labelledby="how-heading">
    <h2 id="how-heading">How it works</h2>
    <ol class="steps">
      <li>Make a timetable here. It takes a name, and no password.</li>
      <li>
        In MyTimetable, export your timetable as a calendar file, and import it. Your classes, rooms
        and the weeks they run all come from that file.
      </li>
      <li>Swap share codes with friends, or send them your link.</li>
      <li>
        Open your week: everyone's classes on one grid, the ones you share, when you're all free, and
        who's in class right now. Link your phone to check it on campus.
      </li>
    </ol>
    <figure>
      <img
        src="/overlay-example.png"
        width="1078"
        height="560"
        alt="A week grid with three people's classes side by side in their own colours. Shared tutorials and lectures are outlined, and the times all three are free are shaded green."
      />
      <figcaption>Three made-up timetables on one week.</figcaption>
    </figure>
  </section>
</Base>
