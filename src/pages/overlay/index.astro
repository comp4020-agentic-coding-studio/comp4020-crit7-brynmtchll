---
import Base from "../../layouts/Base.astro";
import { friendsOf } from "../../lib/friends";
import {
  COLOURS,
  FREE_WINDOW,
  canberraNow,
  freeTogether,
  placeOnGrid,
  sharedWith,
  statusAt,
} from "../../lib/overlay";
import { currentPerson } from "../../lib/people";
import { DAYS, activityLabel, clock, slotsFor } from "../../lib/timetable";

const me = currentPerson(Astro.cookies);
const everyone = me ? [me, ...friendsOf(me)] : [];

// Who's toggled on rides in the query string, so the toggles are a plain
// GET form. No "filtered" flag means nobody has touched them: show everyone.
const params = Astro.url.searchParams;
const shown = params.has("filtered")
  ? everyone.filter((p) => params.getAll("show").includes(String(p.id)))
  : everyone;
const shownIds = shown.map((p) => p.id);

const colour = new Map(everyone.map((p, i) => [p.id, COLOURS[i % COLOURS.length]]));
const nameOf = new Map(everyone.map((p) => [p.id, p.id === me?.id ? "You" : p.name]));

const slots = slotsFor(everyone.map((p) => p.id));
const hasTimetable = new Set(slots.map((s) => s.personId));
const grid = placeOnGrid(
  slots.filter((s) => shownIds.includes(s.personId)),
  shownIds,
);
const shared = me ? sharedWith(slots, me.id, shownIds) : [];
const free = shownIds.length >= 2 ? freeTogether(slots, shownIds) : [];
const freeByDay = DAYS.map((_, i) => free.filter((g) => g.day === i + 1));
const pct = (minutes: number): number => ((minutes - grid.from) / (grid.to - grid.from)) * 100;
const now = canberraNow();
const isWeekday = now.day <= 5;
const nowLine = isWeekday && now.minutes >= grid.from && now.minutes <= grid.to ? pct(now.minutes) : undefined;
const where = (s: { courseCode: string; activity: string; room: string | null }): string =>
  `${s.courseCode} ${activityLabel(s.activity)}${s.room ? ` (${s.room})` : ""}`;
const sharedIds = new Set(shared.map((c) => c.classId));
const list = (ids: number[]): string => {
  // mid-sentence, so "you" rather than the legend's "You"
  const names = ids.map((id) => (id === me?.id ? "you" : (nameOf.get(id) ?? "")));
  return names.length < 2 ? names.join("") : `${names.slice(0, -1).join(", ")} and ${names.at(-1)}`;
};
const hours = Array.from({ length: (grid.to - grid.from) / 60 + 1 }, (_, i) => grid.from + i * 60);
---

<Base title="Overlay" wide>
  <h1>Overlay</h1>
  {
    !me ? (
      <p>
        You don't have a timetable on this device yet. <a href="/">Make one</a>, import your
        MyTimetable export, and add friends to see them here.
      </p>
    ) : (
      <>
        <form method="get" class="people" id="people">
          <input type="hidden" name="filtered" value="1" />
          <fieldset>
            <legend>Show</legend>
            {everyone.map((p) => (
              <label style={`--fill: ${colour.get(p.id)?.fill}; --edge: ${colour.get(p.id)?.edge}`}>
                <input type="checkbox" name="show" value={p.id} checked={shownIds.includes(p.id)} />
                {nameOf.get(p.id)}
                {!hasTimetable.has(p.id) && <span class="muted"> (no timetable yet)</span>}
              </label>
            ))}
          </fieldset>
          <button>Update</button>
        </form>

        {everyone.length === 1 && (
          <p>
            It's just you so far. <a href="/me/#friends">Add friends</a> by their share code to
            overlay them.
          </p>
        )}

        <section aria-labelledby="now-heading">
          <h2 id="now-heading">
            Right now <span class="muted">· {isWeekday ? DAYS[now.day - 1] : "Weekend"} {clock(now.minutes)} in Canberra</span>
          </h2>
          {!isWeekday ? (
            <p>It's the weekend. Nobody has class.</p>
          ) : (
            <ul class="now-list">
              {shown.map((p) => {
                const status = statusAt(slots, p.id, now);
                const who = nameOf.get(p.id);
                const verb = p.id === me.id ? "are" : "is";
                return (
                  <li style={`--edge: ${colour.get(p.id)?.edge}`}>
                    <strong>{who}</strong>{" "}
                    {status.state === "in-class"
                      ? `${verb} in ${where(status.slot)} until ${clock(status.slot.end)}`
                      : status.state === "free"
                        ? `${verb} free until ${clock(status.next.start)}, then ${where(status.next)}`
                        : status.state === "done"
                          ? `${p.id === me.id ? "are" : "is"} done for the day`
                          : `${p.id === me.id ? "have" : "has"} no classes today`}
                  </li>
                );
              })}
            </ul>
          )}
          <p class="muted small">
            Going by the weekly timetable, so teaching breaks and public holidays look like normal weeks.
          </p>
        </section>

        <section aria-labelledby="week-heading" class="week-wrap">
          <h2 id="week-heading">This week</h2>
          <div
            class="week"
            style={`--hours: ${(grid.to - grid.from) / 60}`}
          >
            <div class="hours" aria-hidden="true">
              {hours.map((h) => (
                <span style={`top: ${((h - grid.from) / (grid.to - grid.from)) * 100}%`}>
                  {clock(h)}
                </span>
              ))}
            </div>
            {grid.days.map((blocks, i) => (
              <section class="day" aria-labelledby={`day-${i}`}>
                <h3 id={`day-${i}`}>{DAYS[i]}</h3>
                <div class="day-body">
                  {nowLine !== undefined && i === now.day - 1 && (
                    <div class="now" aria-hidden="true" style={`top: ${nowLine}%`} />
                  )}
                  {freeByDay[i].map((g) => (
                    <div
                      class="free"
                      aria-hidden="true"
                      style={`top: ${pct(g.start)}%; height: ${pct(g.end) - pct(g.start)}%`}
                    />
                  ))}
                  <ol class="blocks">
                  {blocks.map((b) => (
                    <li
                      class:list={["block", { shared: sharedIds.has(b.classId) }]}
                      style={[
                        `top: ${b.top}%`,
                        `height: ${b.height}%`,
                        `left: ${b.left}%`,
                        `width: ${b.width}%`,
                        `--fill: ${colour.get(b.personId)?.fill}`,
                        `--edge: ${colour.get(b.personId)?.edge}`,
                      ].join("; ")}
                      title={`${nameOf.get(b.personId)}: ${b.courseCode} ${activityLabel(b.activity)} ${b.group}, ${clock(b.start)}–${clock(b.end)}${b.room ? `, ${b.room}` : ""}`}
                    >
                      <span class="visually-hidden">
                        {clock(b.start)}–{clock(b.end)},{" "}
                      </span>
                      <strong>{b.courseCode}</strong>{" "}
                      <span class="kind">{activityLabel(b.activity)}</span>{" "}
                      <span class="who">{nameOf.get(b.personId)}</span>
                      {sharedIds.has(b.classId) && <span class="visually-hidden">(shared)</span>}
                    </li>
                  ))}
                  </ol>
                </div>
              </section>
            ))}
          </div>
        </section>

        <section aria-labelledby="free-heading">
          <h2 id="free-heading">Free together</h2>
          {shownIds.length < 2 ? (
            <p>Show a friend above to find time you're all free.</p>
          ) : (
            <>
              <p>
                When {list(shownIds)} are all out of class between {clock(FREE_WINDOW.start)} and{" "}
                {clock(FREE_WINDOW.end)}. It's shaded green on the grid.
              </p>
              <ul class="free-list">
                {DAYS.map((day, i) => (
                  <li>
                    <strong>{day}</strong>:{" "}
                    {freeByDay[i].length === 0
                      ? "no time you're all free"
                      : freeByDay[i].map((g) => `${clock(g.start)}–${clock(g.end)}`).join(", ")}
                  </li>
                ))}
              </ul>
            </>
          )}
        </section>

        <section aria-labelledby="shared-heading">
          <h2 id="shared-heading">Classes you share</h2>
          {shownIds.length < 2 ? (
            <p>Show a friend above to see which classes you share.</p>
          ) : shared.length === 0 ? (
            <p>You don't share any classes with {list(shownIds.filter((id) => id !== me.id))}.</p>
          ) : (
            <ul class="shared-list">
              {shared.map((c) => (
                <li>
                  <strong>{c.courseCode}</strong> {activityLabel(c.activity)} {c.group},{" "}
                  {c.meetings.map((m) => `${DAYS[m.day - 1]} ${clock(m.start)}–${clock(m.end)}`).join(" and ")}{" "}
                  with {list(c.friends)}
                  {c.meetings[0].room && <span class="room"> · {c.meetings[0].room}</span>}
                </li>
              ))}
            </ul>
          )}
        </section>
      </>
    )
  }
</Base>

<script>
  // Toggling a person applies straight away; without JavaScript the Update
  // button does the same.
  const form = document.querySelector<HTMLFormElement>("#people");
  form?.addEventListener("change", () => form.requestSubmit());
</script>
