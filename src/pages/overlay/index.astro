---
import Base from "../../layouts/Base.astro";
import { ISO_DATE, addDays, canberraNow, formatDate, mondayOf } from "../../lib/dates";
import { friendsOf } from "../../lib/friends";
import {
  COLOURS,
  FREE_WINDOW,
  freeTogether,
  inWeek,
  placeOnGrid,
  sharedWith,
  statusAt,
} from "../../lib/overlay";
import { currentPerson } from "../../lib/people";
import { DAYS, activityLabel, clock, slotsFor } from "../../lib/timetable";

const me = currentPerson(Astro.cookies);
const everyone = me ? [me, ...friendsOf(me)] : [];

// Who's toggled on rides in the query string, so the toggles are a plain
// GET form. No "filtered" flag means nobody has touched them: show everyone.
const params = Astro.url.searchParams;
const shown = params.has("filtered")
  ? everyone.filter((p) => params.getAll("show").includes(String(p.id)))
  : everyone;
const shownIds = shown.map((p) => p.id);

const colour = new Map(everyone.map((p, i) => [p.id, COLOURS[i % COLOURS.length]]));
const nameOf = new Map(everyone.map((p) => [p.id, p.id === me?.id ? "You" : p.name]));

// Which week the grid shows: ?week= snaps to its Monday. Otherwise it's
// this week, or next week once this one's teaching days are over.
const now = canberraNow();
const isWeekday = now.day <= 5;
const thisMonday = mondayOf(now.date);
const requested = params.get("week");
const monday =
  requested && ISO_DATE.test(requested)
    ? mondayOf(requested)
    : isWeekday
      ? thisMonday
      : addDays(thisMonday, 7);
const isThisWeek = monday === thisMonday;
const weekLink = (target: string): string => {
  const next = new URLSearchParams(params);
  next.set("week", target);
  return `?${next}`;
};

const slots = slotsFor(everyone.map((p) => p.id));
const hasTimetable = new Set(slots.map((s) => s.personId));
const weekSlots = inWeek(
  slots.filter((s) => shownIds.includes(s.personId)),
  monday,
);
const grid = placeOnGrid(weekSlots, shownIds);
const shared = me ? sharedWith(slots, me.id, shownIds) : [];
const free = shownIds.length >= 2 ? freeTogether(weekSlots, shownIds) : [];
const freeByDay = DAYS.map((_, i) => free.filter((g) => g.day === i + 1));
const pct = (minutes: number): number => ((minutes - grid.from) / (grid.to - grid.from)) * 100;
const nowLine =
  isThisWeek && isWeekday && now.minutes >= grid.from && now.minutes <= grid.to
    ? pct(now.minutes)
    : undefined;
const weekIsEmpty = weekSlots.length === 0 && slots.some((s) => shownIds.includes(s.personId));
const where = (s: { courseCode: string; activity: string; room: string | null }): string =>
  `${s.courseCode} ${activityLabel(s.activity)}${s.room ? ` (${s.room})` : ""}`;
const sharedIds = new Set(shared.map((c) => c.classId));
const list = (ids: number[]): string => {
  // mid-sentence, so "you" rather than the legend's "You"
  const names = ids.map((id) => (id === me?.id ? "you" : (nameOf.get(id) ?? "")));
  return names.length < 2 ? names.join("") : `${names.slice(0, -1).join(", ")} and ${names.at(-1)}`;
};
const hours = Array.from({ length: (grid.to - grid.from) / 60 + 1 }, (_, i) => grid.from + i * 60);
---

<Base title="Overlay" wide>
  <h1>Overlay</h1>
  {
    !me ? (
      <p>
        You don't have a timetable on this device yet. <a href="/">Make one</a>, import your
        MyTimetable export, and add friends to see them here.
      </p>
    ) : (
      <>
        <form method="get" class="people" id="people" data-watch={everyone.map((p) => p.id).join(" ")}>
          <input type="hidden" name="filtered" value="1" />
          {requested && <input type="hidden" name="week" value={monday} />}
          <fieldset>
            <legend>Show</legend>
            {everyone.map((p) => (
              <label style={`--fill: ${colour.get(p.id)?.fill}; --edge: ${colour.get(p.id)?.edge}`}>
                <input type="checkbox" name="show" value={p.id} checked={shownIds.includes(p.id)} />
                {nameOf.get(p.id)}
                {!hasTimetable.has(p.id) && <span class="muted"> (no timetable yet)</span>}
              </label>
            ))}
          </fieldset>
          <button>Update</button>
        </form>

        {everyone.length === 1 && (
          <p>
            It's just you so far. <a href="/me/#friends">Add friends</a> by their share code to
            overlay them.
          </p>
        )}

        <section aria-labelledby="now-heading">
          <h2 id="now-heading">
            Right now <span class="muted">· {isWeekday ? DAYS[now.day - 1] : "Weekend"} {clock(now.minutes)} in Canberra</span>
          </h2>
          {!isWeekday ? (
            <p>It's the weekend. Nobody has class.</p>
          ) : (
            <ul class="now-list">
              {shown.map((p) => {
                const status = statusAt(slots, p.id, now);
                const who = nameOf.get(p.id);
                const verb = p.id === me.id ? "are" : "is";
                return (
                  <li style={`--edge: ${colour.get(p.id)?.edge}`}>
                    <strong>{who}</strong>{" "}
                    {status.state === "in-class"
                      ? `${verb} in ${where(status.slot)} until ${clock(status.slot.end)}`
                      : status.state === "free"
                        ? `${verb} free until ${clock(status.next.start)}, then ${where(status.next)}`
                        : status.state === "done"
                          ? `${p.id === me.id ? "are" : "is"} done for the day`
                          : status.state === "off"
                            ? `${p.id === me.id ? "have" : "has"} no classes today: the usual ${DAYS[now.day - 1]} classes aren't on (a public holiday or the teaching break)`
                            : `${p.id === me.id ? "have" : "has"} no classes today`}
                  </li>
                );
              })}
            </ul>
          )}

        </section>

        <section aria-labelledby="week-heading" class="week-wrap">
          <div class="week-head">
            <h2 id="week-heading">
              Week of {formatDate(monday)}
              {isThisWeek && <span class="muted"> · this week</span>}
            </h2>
            <nav aria-label="Weeks" class="week-nav">
              <a href={weekLink(addDays(monday, -7))}>← Previous week</a>
              {!isThisWeek && <a href={weekLink(thisMonday)}>This week</a>}
              <a href={weekLink(addDays(monday, 7))}>Next week →</a>
            </nav>
          </div>
          {weekIsEmpty && (
            <p role="status">
              Nobody shown has classes this week. Their exports say nothing runs, so it's the
              teaching break or outside semester.
            </p>
          )}
          <div
            class="week"
            style={`--hours: ${(grid.to - grid.from) / 60}`}
          >
            <div class="hours" aria-hidden="true">
              {hours.map((h) => (
                <span style={`top: ${((h - grid.from) / (grid.to - grid.from)) * 100}%`}>
                  {clock(h)}
                </span>
              ))}
            </div>
            {grid.days.map((blocks, i) => (
              <section class="day" aria-labelledby={`day-${i}`}>
                <h3 id={`day-${i}`}>
                  {DAYS[i]} <span class="date">{formatDate(addDays(monday, i)).split(" ")[1]}</span>
                </h3>
                <div class="day-body">
                  {nowLine !== undefined && i === now.day - 1 && (
                    <div class="now" aria-hidden="true" style={`top: ${nowLine}%`} />
                  )}
                  {freeByDay[i].map((g) => (
                    <div
                      class="free"
                      aria-hidden="true"
                      style={`top: ${pct(g.start)}%; height: ${pct(g.end) - pct(g.start)}%`}
                    />
                  ))}
                  <ol class="blocks">
                  {blocks.map((b, k) => {
                    const id = `slot-${i}-${k}`;
                    const who = nameOf.get(b.personId) ?? "";
                    const withWhom = shownIds.filter(
                      (p) => p !== b.personId && weekSlots.some((o) => o.classId === b.classId && o.personId === p),
                    );
                    return (
                      <li
                        class:list={["block", { shared: sharedIds.has(b.classId) }]}
                        style={[
                          `top: ${b.top}%`,
                          `height: ${b.height}%`,
                          `left: ${b.left}%`,
                          `width: ${b.width}%`,
                          `--fill: ${colour.get(b.personId)?.fill}`,
                          `--edge: ${colour.get(b.personId)?.edge}`,
                        ].join("; ")}
                      >
                        {/* the block is a button so the full details are one
                            tap or keypress away when the lane is too narrow
                            to show them; the popover needs no script */}
                        <button type="button" class="block-button" popovertarget={id}>
                          <span class="visually-hidden">
                            {clock(b.start)}–{clock(b.end)},{" "}
                          </span>
                          <strong>
                            <span class="prefix">{b.courseCode.slice(0, 4)}</span>
                            {b.courseCode.slice(4)}
                          </strong>{" "}
                          <span class="kind">{activityLabel(b.activity)}</span>{" "}
                          <span class="who">
                            <span class="who-full">{who}</span>
                            <span class="who-short" aria-hidden="true">{who.slice(0, 1)}</span>
                          </span>
                          {sharedIds.has(b.classId) && <span class="visually-hidden">(shared)</span>}
                        </button>
                        <div popover id={id} class="slot-details" style={`--edge: ${colour.get(b.personId)?.edge}`}>
                          <p class="slot-who">{who}</p>
                          <p>
                            <strong>{b.courseCode}</strong> {b.courseTitle}
                          </p>
                          <p>
                            {activityLabel(b.activity)} {b.group} ({b.activity})
                          </p>
                          <p>
                            {formatDate(addDays(monday, b.day - 1))}, {clock(b.start)}–{clock(b.end)}
                          </p>
                          <p>{b.room ?? "No room listed"}</p>
                          {withWhom.length > 0 && <p>Also here: {list(withWhom)}</p>}
                          <button type="button" popovertarget={id} popovertargetaction="hide">
                            Close
                          </button>
                        </div>
                      </li>
                    );
                  })}
                  </ol>
                </div>
              </section>
            ))}
          </div>
        </section>

        <section aria-labelledby="free-heading">
          <h2 id="free-heading">Free together</h2>
          {shownIds.length < 2 ? (
            <p>Show a friend above to find time you're all free.</p>
          ) : (
            <>
              <p>
                When {list(shownIds)} are {shownIds.length === 2 ? "both" : "all"} out of class between {clock(FREE_WINDOW.start)} and{" "}
                {clock(FREE_WINDOW.end)} in the week of {formatDate(monday)}. It's shaded green on
                the grid.
              </p>
              <ul class="free-list">
                {DAYS.map((day, i) => (
                  <li>
                    <strong>{day}</strong>:{" "}
                    {freeByDay[i].length === 0
                      ? "no time you're all free"
                      : freeByDay[i].map((g) => `${clock(g.start)}–${clock(g.end)}`).join(", ")}
                  </li>
                ))}
              </ul>
            </>
          )}
        </section>

        <section aria-labelledby="shared-heading">
          <h2 id="shared-heading">Classes you share</h2>
          {shownIds.length < 2 ? (
            <p>Show a friend above to see which classes you share.</p>
          ) : shared.length === 0 ? (
            <p>You don't share any classes with {list(shownIds.filter((id) => id !== me.id))}.</p>
          ) : (
            <ul class="shared-list">
              {shared.map((c) => (
                <li>
                  <strong>{c.courseCode}</strong> {activityLabel(c.activity)} {c.group},{" "}
                  {c.meetings
                    .map((m) =>
                      m.dates.length === 1
                        ? `${formatDate(m.dates[0])} ${clock(m.start)}–${clock(m.end)}`
                        : `${DAYS[m.day - 1]} ${clock(m.start)}–${clock(m.end)}`,
                    )
                    .join(" and ")}{" "}
                  with {list(c.friends)}
                  {c.meetings[0].room && <span class="room"> · {c.meetings[0].room}</span>}
                </li>
              ))}
            </ul>
          )}
        </section>
      </>
    )
  }
</Base>

<script>
  // Toggling a person applies straight away; without JavaScript the Update
  // button does the same.
  const form = document.querySelector<HTMLFormElement>("#people");
  form?.addEventListener("change", () => form.requestSubmit());

  // Live: when anyone on this overlay re-imports, the stream says who, and
  // the page reloads to pick up their new timetable from the server. It also
  // reloads every few minutes so "Right now" doesn't go stale on a screen
  // left open.
  const watched = new Set((form?.dataset.watch ?? "").split(" ").filter(Boolean).map(Number));
  let pending: ReturnType<typeof setTimeout> | undefined;
  const reloadSoon = () => {
    clearTimeout(pending);
    pending = setTimeout(() => location.reload(), 300);
  };
  if (watched.size > 0) {
    const source = new EventSource("/api/events");
    source.addEventListener("message", (event) => {
      const { personId } = JSON.parse(event.data) as { personId: number };
      if (watched.has(personId)) reloadSoon();
    });
    setInterval(() => {
      if (document.visibilityState === "visible") location.reload();
    }, 5 * 60_000);
  }
</script>
