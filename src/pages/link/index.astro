---
import Base from "../../layouts/Base.astro";
import { LIMITED, clientOf, guardedLookup } from "../../lib/limits";
import { currentPerson, formatLinkCode, normaliseShareCode, peekDeviceLink } from "../../lib/people";

// Opening a timetable on a second device. Reading this page changes nothing;
// the code is only spent by the button, so a chat app previewing the link
// can't use it up.
const code = normaliseShareCode(Astro.url.searchParams.get("code") ?? "");
const found = code ? guardedLookup(clientOf(Astro.request, Astro.clientAddress), () => peekDeviceLink(code)) : undefined;
const limited = found === LIMITED || Astro.url.searchParams.get("failed") === "limited";
const owner = found === LIMITED ? undefined : found;
const here = currentPerson(Astro.cookies);
const failed = Astro.url.searchParams.has("failed") && !limited;
---

<Base title="Link this device">
  <h1>Link this device</h1>
  {
    limited && (
      <p class="notice error" role="alert">
        Too many codes that didn't match from here. Wait ten minutes, then make a fresh code on your
        other device.
      </p>
    )
  }
  {
    failed && (
      <p class="notice error" role="alert">
        That code didn't work. Codes work once, for ten minutes. Make a new one on your other device.
      </p>
    )
  }
  {
    owner ? (
      <section class="card start" aria-labelledby="open-heading">
        <h2 id="open-heading">Open {owner.name}'s timetable here?</h2>
        {here && here.id !== owner.id ? (
          <p>
            This device has {here.name}'s timetable at the moment. Linking switches it; {here.name}'s
            timetable stays on any other device it's linked to.
          </p>
        ) : (
          <p>This device will have the same timetable, friends and week as the one you linked from.</p>
        )}
        <form method="post" action="/api/devices/claim">
          <input type="hidden" name="code" value={code} />
          <button class="primary">Open {owner.name}'s timetable here</button>
        </form>
      </section>
    ) : (
      <section class="card" aria-labelledby="enter-heading">
        <h2 id="enter-heading">Enter a device code</h2>
        {code && !failed && !limited && (
          <p class="notice error" role="alert">
            That code has expired or been used.
          </p>
        )}
        <p>
          On a device that has your timetable, open <strong>My timetable</strong>, choose "Link another
          device", and enter the code it shows.
        </p>
        <form method="get">
          <label for="code">Code</label>
          <div class="inline-field">
            <input
              id="code"
              name="code"
              required
              maxlength="12"
              autocomplete="one-time-code"
              autocapitalize="characters"
              spellcheck="false"
              placeholder={formatLinkCode("ABCD2345")}
            />
            <button class="primary">Continue</button>
          </div>
        </form>
      </section>
    )
  }
</Base>
