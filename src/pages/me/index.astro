---
import ImportForm from "../../components/ImportForm.astro";
import QrCode from "../../components/QrCode.astro";
import Base from "../../layouts/Base.astro";
import { formatDate } from "../../lib/dates";
import { NAME_LENGTH, currentPerson, deviceCount, formatLinkCode } from "../../lib/people";
import { DAYS, activityLabel, clock, isOneOff, prettyGroup, prettyRoom, slotsFor } from "../../lib/timetable";

// Your own data: your classes, where they came from, your name, your
// devices, and deleting it all. Friends live on /friends/.
const params = Astro.url.searchParams;

// Share links used to point here; they still work.
if (params.has("add")) return Astro.redirect(`/friends/?add=${encodeURIComponent(params.get("add") ?? "")}`);

const me = currentPerson(Astro.cookies);
const slots = me ? slotsFor([me.id]) : [];
const weekly = slots.filter((s) => !isOneOff(s));
const byDay = DAYS.map((day, i) => ({ day, list: weekly.filter((s) => s.day === i + 1) }));
const oneOffs = slots
  .filter(isOneOff)
  .sort((a, b) => a.dates[0].localeCompare(b.dates[0]) || a.start - b.start);
const classCount = new Set(slots.map((s) => s.classId)).size;

const devices = me ? deviceCount(me) : 0;
const linkCode = params.get("link");
const linkUrl = linkCode ? new URL(`/link/?code=${linkCode}`, Astro.url).href : undefined;

const imported = params.get("import") === "ok";
const importError = (() => {
  switch (params.get("import")) {
    case "empty":
      return "No classes found in that. It should be the .ics file MyTimetable exports.";
    case "too-big":
      return "That file is far bigger than a timetable export.";
    default:
      return undefined;
  }
})();
const skipped = Number(params.get("skipped") ?? 0);
---

<Base title="My timetable">
  <h1>My timetable</h1>
  {
    !me ? (
      <div class="card">
        <p>You don't have a timetable on this device yet.</p>
        <div class="actions">
          <a class="button primary" href="/">
            Make a timetable
          </a>
          <a class="button" href="/link/">
            It's on another device
          </a>
        </div>
      </div>
    ) : (
      <>
        {imported && (
          <div class="notice success" role="status">
            <p>
              Imported {params.get("classes")} classes.
              {skipped > 0 && ` Skipped ${skipped} weekend sessions.`}
            </p>
            <div class="actions">
              <a class="button small primary" href="/overlay/">
                See your week
              </a>
              <a class="button small" href="/friends/#add">
                Add friends
              </a>
            </div>
          </div>
        )}

        {slots.length === 0 && <ImportForm first error={importError} />}

        {slots.length > 0 && (
          <section id="timetable" class="card" aria-labelledby="timetable-heading">
            <div class="card-head">
              <h2 id="timetable-heading">Your classes</h2>
              <span class="fine">{classCount} classes, from your MyTimetable export</span>
            </div>
            <dl class="days">
              {byDay
                .filter((d) => d.list.length > 0)
                .map((d) => (
                  <>
                    <dt>{d.day}</dt>
                    <dd>
                      <ul class="rows">
                        {d.list.map((s) => (
                          <li>
                            <span class="when">
                              <span class="visually-hidden">{d.day} </span>
                              {clock(s.start)}–{clock(s.end)}
                            </span>
                            <span class="grow">
                              <strong>{s.courseCode}</strong> {activityLabel(s.activity)} {prettyGroup(s.group)}
                              {s.room && <span class="room"> · {prettyRoom(s.room)}</span>}
                            </span>
                          </li>
                        ))}
                      </ul>
                    </dd>
                  </>
                ))}
            </dl>
            {oneOffs.length > 0 && (
              <>
                <h3>One-off sessions</h3>
                <ul class="rows">
                  {oneOffs.map((s) => (
                    <li>
                      <span class="when dated">
                        {formatDate(s.dates[0])} {clock(s.start)}–{clock(s.end)}
                      </span>
                      <span class="grow">
                        <strong>{s.courseCode}</strong> {activityLabel(s.activity)} {prettyGroup(s.group)}
                        {s.room && <span class="room"> · {prettyRoom(s.room)}</span>}
                      </span>
                    </li>
                  ))}
                </ul>
              </>
            )}
          </section>
        )}

        {slots.length > 0 && <ImportForm first={false} error={importError} />}

        <section id="name" class="card" aria-labelledby="name-heading">
          <h2 id="name-heading">Your name</h2>
          {params.get("renamed") === "1" && (
            <p class="notice success" role="status">
              Saved. Friends see the new name from now on.
            </p>
          )}
          {params.get("renamed") === "empty" && (
            <p class="notice error" role="alert">
              A name can't be empty.
            </p>
          )}
          <form method="post" action="/api/people/rename">
            <label for="rename">Friends see you as</label>
            <div class="inline-field">
              <input
                id="rename"
                name="name"
                value={me.name}
                required
                maxlength={NAME_LENGTH}
                autocomplete="nickname"
              />
              <button>Save</button>
            </div>
          </form>
        </section>

        <section id="devices" class="card" aria-labelledby="devices-heading">
          <h2 id="devices-heading">Your devices</h2>
          {params.get("devices") === "signed-out" && (
            <p class="notice success" role="status">
              Signed out everywhere else. Only this device has your timetable now.
            </p>
          )}
          <p>
            {devices === 1
              ? "Your timetable is only on this device. Link your phone so you can check it on campus, and so losing this device doesn't lose it."
              : `Your timetable is on ${devices} devices.`}
          </p>
          {linkCode && linkUrl ? (
            <div class="notice" role="status">
              <div class="share-grid">
                <div>
                  <p>
                    <strong>Scan this with your phone's camera</strong>, or on your other device go to{" "}
                    <strong>/link</strong> and enter
                  </p>
                  <p class="code">{formatLinkCode(linkCode)}</p>
                  <p class="link-text" id="device-link">{linkUrl}</p>
                  <div class="actions">
                    <button type="button" class="small" data-copy={linkUrl} hidden>
                      Copy link
                    </button>
                  </div>
                </div>
                <QrCode value={linkUrl} label="QR code that links your phone" />
              </div>
              <p class="fine">
                It works once, in the next ten minutes. Anyone with it can open your timetable, so
                only send it to yourself.
              </p>
            </div>
          ) : (
            <form method="post" action="/api/devices/link">
              <button class="primary">Link another device</button>
            </form>
          )}
          <div class="actions">
            {devices > 1 && (
              <form method="post" action="/api/devices/sign-out">
                <input type="hidden" name="which" value="others" />
                <button class="small">Sign out other devices</button>
              </form>
            )}
            <form method="post" action="/api/devices/sign-out">
              <input type="hidden" name="which" value="this" />
              <button class="small">
                {devices > 1 ? "Sign out this device" : "Sign out (this loses your timetable)"}
              </button>
            </form>
          </div>
        </section>

        <section id="delete" class="card danger-zone" aria-labelledby="delete-heading">
          <h2 id="delete-heading">Delete your timetable</h2>
          <p>
            This deletes your timetable, your friends list and your share code, from every device,
            and takes you off everyone's week. It can't be undone.
          </p>
          {params.get("delete") === "unconfirmed" && (
            <p class="notice error" role="alert">
              Tick the box to confirm. Nothing was deleted.
            </p>
          )}
          <form method="post" action="/api/people/delete">
            <label class="confirm">
              <input type="checkbox" name="confirm" value="yes" required />
              I understand this can't be undone
            </label>
            <button class="danger-button">Delete my timetable</button>
          </form>
        </section>
      </>
    )
  }
</Base>
