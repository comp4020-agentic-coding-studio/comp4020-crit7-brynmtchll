---
import Base from "../../layouts/Base.astro";
import { type FollowResult, friendsOf } from "../../lib/friends";
import { currentPerson, deviceCount, formatLinkCode } from "../../lib/people";
import { formatDate } from "../../lib/dates";
import { DAYS, activityLabel, clock, isOneOff, slotsFor } from "../../lib/timetable";

const me = currentPerson(Astro.cookies);
const friends = me ? friendsOf(me) : [];
const slots = me ? slotsFor([me.id]) : [];
const weekly = slots.filter((s) => !isOneOff(s));
const oneOffs = slots
  .filter(isOneOff)
  .sort((a, b) => a.dates[0].localeCompare(b.dates[0]) || a.start - b.start);

const params = Astro.url.searchParams;
const devices = me ? deviceCount(me) : 0;
const linkCode = params.get("link");
const linkUrl = linkCode ? new URL(`/link/?code=${linkCode}`, Astro.url).href : undefined;

const FOLLOW_MESSAGES: Record<FollowResult, string> = {
  added: "Friend added. They're on your overlay now.",
  unknown: "No timetable has that code. Check it with your friend.",
  self: "That's your own code.",
};
const followOutcome = params.get("friend") as FollowResult | null;
const followMessage = followOutcome ? FOLLOW_MESSAGES[followOutcome] : undefined;

const importMessage = (() => {
  switch (params.get("import")) {
    case "ok": {
      const skipped = Number(params.get("skipped"));
      return (
        `Imported ${params.get("classes")} classes.` +
        (skipped > 0 ? ` Skipped ${skipped} weekend sessions.` : "")
      );
    }
    case "empty":
      return "No classes found in that. It should be the .ics file MyTimetable exports.";
    case "too-big":
      return "That file is far bigger than a timetable export.";
    default:
      return undefined;
  }
})();
---

<Base title="My timetable">
  <h1>My timetable</h1>
  {
    me ? (
      <>
        <section aria-labelledby="share-heading">
          <h2 id="share-heading">Your share code</h2>
          <p>
            Give this to friends so they can overlay your timetable:{" "}
            <strong class="share-code">{me.shareCode}</strong>
          </p>
        </section>

        <section id="timetable" aria-labelledby="timetable-heading">
          <h2 id="timetable-heading">Your classes</h2>
          {params.get("import") === "ok" && <p role="status">{importMessage}</p>}
          {slots.length === 0 ? (
            <p>Nothing yet. Import your MyTimetable export below.</p>
          ) : (
            <ul class="classes">
              {weekly.map((s) => (
                <li>
                  <span class="when">
                    {DAYS[s.day - 1]} {clock(s.start)}–{clock(s.end)}
                  </span>{" "}
                  <strong>{s.courseCode}</strong> {activityLabel(s.activity)} {s.group}
                  {s.room && <span class="room"> · {s.room}</span>}
                </li>
              ))}
            </ul>
          )}
          {oneOffs.length > 0 && (
            <>
              <h3>One-off sessions</h3>
              <ul class="classes">
                {oneOffs.map((s) => (
                  <li>
                    <span class="when">
                      {formatDate(s.dates[0])} {clock(s.start)}–{clock(s.end)}
                    </span>{" "}
                    <strong>{s.courseCode}</strong> {activityLabel(s.activity)} {s.group}
                    {s.room && <span class="room"> · {s.room}</span>}
                  </li>
                ))}
              </ul>
            </>
          )}
        </section>

        <section id="import" aria-labelledby="import-heading">
          <h2 id="import-heading">Import from MyTimetable</h2>
          <p>
            In MyTimetable, export your timetable as a calendar (.ics) and upload it here, or
            paste its contents. Importing again replaces your classes, so do it whenever your
            allocation changes.
          </p>
          {importMessage && params.get("import") !== "ok" && (
            <p role="alert">{importMessage}</p>
          )}
          <form method="post" action="/api/import" enctype="multipart/form-data" class="stacked">
            <label for="ics">Calendar file</label>
            <input id="ics" name="ics" type="file" accept=".ics,text/calendar" />
            <label for="pasted">…or paste it</label>
            <textarea id="pasted" name="pasted" rows="4" spellcheck="false"
              placeholder="BEGIN:VCALENDAR"></textarea>
            <button>Import</button>
          </form>
        </section>

        <section id="devices" aria-labelledby="devices-heading">
          <h2 id="devices-heading">Your devices</h2>
          <p>
            {devices === 1
              ? "Your timetable is only on this device. Link another (your phone, say) so you can check it on the go, and so losing this one doesn't lose it."
              : `Your timetable is on ${devices} devices.`}
          </p>
          {params.get("devices") === "signed-out" && (
            <p role="status">Signed out everywhere else. Only this device has your timetable now.</p>
          )}
          {linkCode && linkUrl ? (
            <div class="link-code" role="status">
              <p>
                On your other device, open <a href={linkUrl}>{linkUrl}</a>, or go to{" "}
                <strong>/link</strong> and enter <strong class="share-code">{formatLinkCode(linkCode)}</strong>.
              </p>
              <p class="muted small">
                It works once, in the next ten minutes. Anyone with it can open your timetable, so
                only send it to yourself.
              </p>
            </div>
          ) : (
            <form method="post" action="/api/devices/link">
              <button>Link another device</button>
            </form>
          )}
          <div class="device-actions">
            {devices > 1 && (
              <form method="post" action="/api/devices/sign-out">
                <input type="hidden" name="which" value="others" />
                <button>Sign out other devices</button>
              </form>
            )}
            <form method="post" action="/api/devices/sign-out">
              <input type="hidden" name="which" value="this" />
              <button>
                {devices > 1 ? "Sign out this device" : "Sign out (this loses your timetable)"}
              </button>
            </form>
          </div>
        </section>

        <section id="friends" aria-labelledby="friends-heading">
          <h2 id="friends-heading">Friends</h2>
          {followMessage && <p role="status">{followMessage}</p>}
          <form method="post" action="/api/friends">
            <label for="code">Add a friend by their share code</label>
            <input
              id="code"
              name="code"
              required
              maxlength="12"
              autocomplete="off"
              autocapitalize="characters"
              spellcheck="false"
            />
            <button>Add friend</button>
          </form>
          {friends.length === 0 ? (
            <p>No friends yet. Ask someone for their code.</p>
          ) : (
            <ul class="friends">
              {friends.map((friend) => (
                <li>
                  <span>{friend.name}</span>
                  <form method="post" action="/api/friends/remove">
                    <input type="hidden" name="friend" value={friend.id} />
                    <button aria-label={`Remove ${friend.name}`}>Remove</button>
                  </form>
                </li>
              ))}
            </ul>
          )}
        </section>
      </>
    ) : (
      <p>
        You don't have a timetable on this device yet. <a href="/">Make one</a>
        — it takes a name.
      </p>
    )
  }
</Base>
