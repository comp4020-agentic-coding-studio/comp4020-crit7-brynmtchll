---
import ImportForm from "../../components/ImportForm.astro";
import Base from "../../layouts/Base.astro";
import { type FollowResult, followersOf, friendsOf } from "../../lib/friends";
import {
  currentPerson,
  deviceCount,
  formatLinkCode,
  normaliseShareCode,
  personByShareCode,
} from "../../lib/people";
import { formatDate } from "../../lib/dates";
import { DAYS, activityLabel, clock, isOneOff, slotsFor } from "../../lib/timetable";

const me = currentPerson(Astro.cookies);
const friends = me ? friendsOf(me) : [];
const slots = me ? slotsFor([me.id]) : [];
const weekly = slots.filter((s) => !isOneOff(s));
const oneOffs = slots
  .filter(isOneOff)
  .sort((a, b) => a.dates[0].localeCompare(b.dates[0]) || a.start - b.start);

const params = Astro.url.searchParams;
const followers = me ? followersOf(me) : [];
const shareLink = me ? new URL(`/me/?add=${me.shareCode}`, Astro.url).href : undefined;
// arriving from someone's share link: offer to add them (a GET only offers;
// the button's POST adds)
const addCode = normaliseShareCode(params.get("add") ?? "");
const invitedBy = addCode ? personByShareCode(addCode) : undefined;
const alreadyFriends = invitedBy ? friends.some((f) => f.id === invitedBy.id) : false;
const devices = me ? deviceCount(me) : 0;
const linkCode = params.get("link");
const linkUrl = linkCode ? new URL(`/link/?code=${linkCode}`, Astro.url).href : undefined;

const FOLLOW_MESSAGES: Record<FollowResult, string> = {
  added: "Friend added. They're on your overlay now.",
  unknown: "No timetable has that code. Check it with your friend.",
  self: "That's your own code.",
};
const followOutcome = params.get("friend") as FollowResult | null;
const followMessage = followOutcome ? FOLLOW_MESSAGES[followOutcome] : undefined;

const importMessage = (() => {
  switch (params.get("import")) {
    case "ok": {
      const skipped = Number(params.get("skipped"));
      return (
        `Imported ${params.get("classes")} classes.` +
        (skipped > 0 ? ` Skipped ${skipped} weekend sessions.` : "")
      );
    }
    case "empty":
      return "No classes found in that. It should be the .ics file MyTimetable exports.";
    case "too-big":
      return "That file is far bigger than a timetable export.";
    default:
      return undefined;
  }
})();
const importError = params.get("import") !== "ok" ? importMessage : undefined;
---

<Base title="My timetable">
  <h1>My timetable</h1>
  {
    me ? (
      <>
        {invitedBy && invitedBy.id !== me.id && (
          <section class="invite" aria-labelledby="invite-heading">
            <h2 id="invite-heading">Add {invitedBy.name}?</h2>
            {alreadyFriends ? (
              <p>{invitedBy.name} is already on your overlay.</p>
            ) : (
              <form method="post" action="/api/friends">
                <input type="hidden" name="code" value={addCode} />
                <button>Add {invitedBy.name} to my overlay</button>
              </form>
            )}
          </section>
        )}
        {addCode && !invitedBy && (
          <p role="alert">That share link doesn't match anyone's timetable. It may have been replaced.</p>
        )}

        {slots.length === 0 && <ImportForm first error={importError} />}

        <section id="share" aria-labelledby="share-heading">
          <h2 id="share-heading">Your share code</h2>
          {params.get("code") === "new" && (
            <p role="status">
              New code. The old one no longer works, but anyone who already added you still sees
              you: remove them below if that's the point.
            </p>
          )}
          <p>
            Give this to friends so they can overlay your timetable:{" "}
            <strong class="share-code">{me.shareCode}</strong>
          </p>
          <p>
            Or send the link: <a href={shareLink}>{shareLink}</a>
          </p>
          <form method="post" action="/api/people/share-code">
            <button>Get a new code</button>
          </form>
        </section>

        <section id="timetable" aria-labelledby="timetable-heading">
          <h2 id="timetable-heading">Your classes</h2>
          {params.get("import") === "ok" && <p role="status">{importMessage}</p>}
          {slots.length === 0 ? (
            <p>None yet: import them above.</p>
          ) : (
            <ul class="classes">
              {weekly.map((s) => (
                <li>
                  <span class="when">
                    {DAYS[s.day - 1]} {clock(s.start)}–{clock(s.end)}
                  </span>{" "}
                  <strong>{s.courseCode}</strong> {activityLabel(s.activity)} {s.group}
                  {s.room && <span class="room"> · {s.room}</span>}
                </li>
              ))}
            </ul>
          )}
          {oneOffs.length > 0 && (
            <>
              <h3>One-off sessions</h3>
              <ul class="classes">
                {oneOffs.map((s) => (
                  <li>
                    <span class="when">
                      {formatDate(s.dates[0])} {clock(s.start)}–{clock(s.end)}
                    </span>{" "}
                    <strong>{s.courseCode}</strong> {activityLabel(s.activity)} {s.group}
                    {s.room && <span class="room"> · {s.room}</span>}
                  </li>
                ))}
              </ul>
            </>
          )}
        </section>

        {slots.length > 0 && <ImportForm first={false} error={importError} />}

        <section id="devices" aria-labelledby="devices-heading">
          <h2 id="devices-heading">Your devices</h2>
          <p>
            {devices === 1
              ? "Your timetable is only on this device. Link another (your phone, say) so you can check it on the go, and so losing this one doesn't lose it."
              : `Your timetable is on ${devices} devices.`}
          </p>
          {params.get("devices") === "signed-out" && (
            <p role="status">Signed out everywhere else. Only this device has your timetable now.</p>
          )}
          {linkCode && linkUrl ? (
            <div class="link-code" role="status">
              <p>
                On your other device, open <a href={linkUrl}>{linkUrl}</a>, or go to{" "}
                <strong>/link</strong> and enter <strong class="share-code">{formatLinkCode(linkCode)}</strong>.
              </p>
              <p class="muted small">
                It works once, in the next ten minutes. Anyone with it can open your timetable, so
                only send it to yourself.
              </p>
            </div>
          ) : (
            <form method="post" action="/api/devices/link">
              <button>Link another device</button>
            </form>
          )}
          <div class="device-actions">
            {devices > 1 && (
              <form method="post" action="/api/devices/sign-out">
                <input type="hidden" name="which" value="others" />
                <button>Sign out other devices</button>
              </form>
            )}
            <form method="post" action="/api/devices/sign-out">
              <input type="hidden" name="which" value="this" />
              <button>
                {devices > 1 ? "Sign out this device" : "Sign out (this loses your timetable)"}
              </button>
            </form>
          </div>
        </section>

        <section id="friends" aria-labelledby="friends-heading">
          <h2 id="friends-heading">Friends</h2>
          {followMessage && <p role="status">{followMessage}</p>}
          <form method="post" action="/api/friends">
            <label for="code">Add a friend by their share code</label>
            <input
              id="code"
              name="code"
              required
              maxlength="12"
              autocomplete="off"
              autocapitalize="characters"
              spellcheck="false"
            />
            <button>Add friend</button>
          </form>
          <h3>On your overlay</h3>
          {friends.length === 0 ? (
            <p>No one yet. Ask someone for their code.</p>
          ) : (
            <ul class="friends">
              {friends.map((friend) => (
                <li>
                  <span>{friend.name}</span>
                  <form method="post" action="/api/friends/remove">
                    <input type="hidden" name="friend" value={friend.id} />
                    <button aria-label={`Remove ${friend.name} from your overlay`}>Remove</button>
                  </form>
                </li>
              ))}
            </ul>
          )}
        </section>

        <section id="visible" aria-labelledby="visible-heading">
          <h2 id="visible-heading">Who can see you</h2>
          {params.get("follower") === "removed" && (
            <p role="status">Removed. They'd need your code again to add you back.</p>
          )}
          {followers.length === 0 ? (
            <p>Nobody has added your code yet.</p>
          ) : (
            <>
              <p>These people added your code, so your week is on their overlay.</p>
              <ul class="friends">
                {followers.map((follower) => (
                  <li>
                    <span>{follower.name}</span>
                    <form method="post" action="/api/friends/remove-follower">
                      <input type="hidden" name="follower" value={follower.id} />
                      <button aria-label={`Stop ${follower.name} seeing your timetable`}>Remove</button>
                    </form>
                  </li>
                ))}
              </ul>
            </>
          )}
        </section>

        <section id="delete" aria-labelledby="delete-heading" class="danger">
          <h2 id="delete-heading">Delete your timetable</h2>
          <p>
            This deletes your timetable, your friends list and your share code, from every device,
            and takes you off everyone's overlay. It can't be undone.
          </p>
          {params.get("delete") === "unconfirmed" && (
            <p role="alert">Tick the box to confirm. Nothing was deleted.</p>
          )}
          <form method="post" action="/api/people/delete" class="stacked">
            <label class="confirm">
              <input type="checkbox" name="confirm" value="yes" required />
              I understand this can't be undone
            </label>
            <button>Delete my timetable</button>
          </form>
        </section>
      </>
    ) : (
      <p>
        You don't have a timetable on this device yet.{" "}
        <a href={addCode ? `/?add=${addCode}` : "/"}>Make one</a>, which takes a name
        {addCode && ", and then you can add the friend who sent you here"}. If it's on another
        device of yours, <a href="/link/">link this one</a>.
      </p>
    )
  }
</Base>
