---
import "../styles.css";

interface Props {
  title: string;
  // the overlay's week grid wants the whole screen, not a reading column
  wide?: boolean;
}

const { title, wide = false } = Astro.props;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Timetable overlay</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Home</a>
      <a href="/me/">My timetable</a>
      <a href="/overlay/">Overlay</a>
      <a href="/readme/">About</a>
    </nav>
    <main class:list={{ wide }}>
      <slot />
    </main>
  </body>
</html>
